        {
            total++;
        }
    }
    if(total == 0)
    {
        printf("Min Swaps: 0");
        return 0;
    }
    if(total == 1)
    {
        printf("Min Swaps: 0");
        return 0;
    }
    for(i = 0; i < total; i++)
    {
        if(arr[i] == 1)
        {
            current++;
